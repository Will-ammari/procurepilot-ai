    {
      "id": 8,
      "title": "Metrics freshness in seconds",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "procurepilot-prometheus"
      },
      "targets": [
        {
          "expr": "time() - procurepilot_export_timestamp_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
