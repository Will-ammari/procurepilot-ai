{
  "name": "procurepilot-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && npm run check:overlay && vite build --config vite.config.ts && npm run analyze:bundle",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:list": "playwright test --list",
    "analyze:bundle": "node scripts/report-bundle.mjs",
    "check:overlay": "node scripts/check-overlay.mjs",
    "predev": "npm run check:overlay",
    "check:shadowed": "node scripts/shadowed-sources.mjs",
    "clean:shadowed": "node scripts/shadowed-sources.mjs --quarantine",
    "test:tooling": "node --test scripts/shadowed-sources.test.mjs scripts/contrast-tokens.test.mjs",
    "lint": "eslint src e2e",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" \"docs/**/*.md\"",
    "test:a11y": "playwright test e2e/session-accessibility.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "5.1.1",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.2",
    "eslint": "^9.39.1",
    "@typescript-eslint/parser": "^8.46.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  }
}
