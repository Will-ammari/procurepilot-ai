APP_NAME="ProcurePilot AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Debug disabled here; configure a unique APP_KEY before starting.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=ops_json
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=procurepilot
DB_USERNAME=procurepilot
DB_PASSWORD=replace-with-unique-local-password
MYSQL_ROOT_PASSWORD=replace-with-another-unique-local-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_QUEUE=procurement-events
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@procurepilot.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT=5

# Local monitoring profile: do not use a real service password in version control.
OPS_METRICS_ENABLED=true
OPS_EXPORT_WINDOW_MINUTES=5
OPS_EXPORT_INTERVAL_SECONDS=15
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-strong-password
